# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Google Cloud Vision
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-cloud.json

# DeepL
DEEPL_API_KEY=your-deepl-api-key

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Stripe
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_STARTER_PRICE_ID=price_starter
STRIPE_PRO_PRICE_ID=price_professional
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise

# Resend
RESEND_API_KEY=re_your-resend-api-key
FROM_EMAIL=noreply@orange.digital

# Redis
REDIS_URL=redis://redis:6379/0

# Sentry
SENTRY_DSN_BACKEND=https://your-backend-dsn@sentry.io/1
SENTRY_DSN_FRONTEND=https://your-frontend-dsn@sentry.io/2

# PostHog
POSTHOG_KEY=phc_your-posthog-key
POSTHOG_HOST=https://app.posthog.com

# App
DEBUG=false
ALLOWED_ORIGINS=https://your-domain.com
