# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Frontend (Vite) — build-time variables inlined into the JS bundle by Vite
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are REQUIRED for Docker Compose builds.
# The remaining VITE_* variables are optional.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Google Cloud Vision
GOOGLE_APPLICATION_CREDENTIALS=credentials/google-cloud.json

# DeepL
DEEPL_API_KEY=your-deepl-api-key

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_STARTER_PRICE_ID=price_starter
STRIPE_PRO_PRICE_ID=price_professional
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise

# Resend
RESEND_API_KEY=re_your-resend-api-key
FROM_EMAIL=noreply@orange.digital

# Redis
REDIS_URL=redis://localhost:6379/0

# Sentry
SENTRY_DSN_BACKEND=https://your-backend-dsn@sentry.io/1
SENTRY_DSN_FRONTEND=https://your-frontend-dsn@sentry.io/2

# PostHog
POSTHOG_KEY=phc_your-posthog-key
POSTHOG_HOST=https://app.posthog.com

# App
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
